ENVIRONMENT=production
LOG_LEVEL=WARNING

DATABASE_URL=postgresql+asyncpg://stakemind:change-me@postgres:5432/stakemind
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

REDIS_URL=redis://redis:6379/0
REDIS_DEFAULT_TTL_SECONDS=300
REDIS_SESSION_TTL_SECONDS=86400

CORS_ORIGINS=https://app.stakemind.example

NEXT_PUBLIC_API_URL=https://api.stakemind.example
API_URL=http://api:8000
