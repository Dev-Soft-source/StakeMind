ENVIRONMENT=staging
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://stakemind:change-me@postgres:5432/stakemind
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0
REDIS_DEFAULT_TTL_SECONDS=300
REDIS_SESSION_TTL_SECONDS=86400

CORS_ORIGINS=https://staging.stakemind.example

NEXT_PUBLIC_API_URL=https://api-staging.stakemind.example
API_URL=http://api:8000
