ENVIRONMENT=staging
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://stakemind:change-me@postgres:5432/stakemind
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0
REDIS_DEFAULT_TTL_SECONDS=300
REDIS_SESSION_TTL_SECONDS=86400

CORS_ORIGINS=https://staging.stakemind.example

BITTENSOR_RPC_URL=https://entrypoint-finney.opentensor.ai:443
BITTENSOR_RPC_TIMEOUT_SECONDS=10
BITTENSOR_RPC_MAX_RETRIES=3
BITTENSOR_INGESTION_SUBNET_LIMIT=16

STAKING_TRANSACTION_TTL_SECONDS=900
STAKING_CONFIRMATION_TARGET_BLOCKS=3
STAKING_ENABLE_SIMULATION=true

INTELLIGENCE_RECOMPUTE_WINDOW_DAYS=30
INTELLIGENCE_CACHE_TTL_SECONDS=300

# Match production hardening (tune per environment)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
TRUST_X_FORWARDED_FOR=true
SECURITY_HSTS_ENABLED=true

NEXT_PUBLIC_API_URL=https://api-staging.stakemind.example
API_URL=http://api:8000

# Optional: error tracking when Sentry (or similar) is wired in the app
# SENTRY_DSN=
