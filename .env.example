ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://stakemind:stakemind@localhost:5432/stakemind
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0
# Validator catalog and aggregate reads
REDIS_DEFAULT_TTL_SECONDS=300
# Wallet session and rate-limit buckets
REDIS_SESSION_TTL_SECONDS=86400

CORS_ORIGINS=http://localhost:3000

BITTENSOR_RPC_URL=https://entrypoint-finney.opentensor.ai:443
BITTENSOR_RPC_TIMEOUT_SECONDS=10
BITTENSOR_RPC_MAX_RETRIES=3
BITTENSOR_INGESTION_SUBNET_LIMIT=16

STAKING_TRANSACTION_TTL_SECONDS=900
STAKING_CONFIRMATION_TARGET_BLOCKS=3
STAKING_ENABLE_SIMULATION=true

INTELLIGENCE_RECOMPUTE_WINDOW_DAYS=30
INTELLIGENCE_CACHE_TTL_SECONDS=300

# Premium: create invite codes with `python backend/scripts/create_premium_invite.py`
# Automation: run `python backend/scripts/run_automation_worker.py` to process queued jobs

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_WALLET=5GKh6cqk9RFUcL4oHfNrBYa5C43ioDfrw561dTefqzy8QTWC
